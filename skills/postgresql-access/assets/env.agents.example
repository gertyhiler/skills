# Fictional values only; use a least-privileged account.
# Select the actual TLS policy of your database. No mode means libpq prefer
# (TLS if available, otherwise non-TLS); verify-full requires a trusted CA.
DATABASE_URL=postgresql://investigator:replace-locally@db.example.invalid:5432/example?schema=public&sslmode=verify-full
# Optional private CA, relative to this env file:
# PGSSLROOTCERT=certs/database-ca.pem
# Alternatively supply PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD and PGSSLMODE.
